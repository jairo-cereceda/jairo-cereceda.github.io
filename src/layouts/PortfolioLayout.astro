---
import MainLayout from '@layouts/MainLayout.astro';
import MainCard from '@components/organisms/MainCard.astro';
import Contact from '@components/organisms/Contact.astro';
import FactSlider from '@components/organisms/FactSlider.astro';
import ContentList from '@components/organisms/ContentList.astro';
import {
  getMainCardData,
  getContentListData,
  getFactSliderData,
  getContactData,
} from '@data/index';
import { type SchemaData } from '@layouts/FirstLayout.astro';
import type { Lang } from '@data/consts';

export interface Props {
  pageTitle: string;
  pageDescription?: string;
  schema?: SchemaData;
  isScrollable?: boolean;
}

const { isScrollable, pageTitle, pageDescription, schema } = Astro.props;

const lang = (Astro.currentLocale ??
  (Astro.url.pathname.startsWith('/en') ? 'en' : 'es')) as Lang;

const mainCard = getMainCardData(lang);
const contentList = getContentListData(lang);
const factSlider = getFactSliderData(lang);
const contactData = getContactData(lang);

const scrollStyling = isScrollable
  ? 'rounded-2xl overflow-y-auto shadow-2xl border border-white/80'
  : 'lg:rounded-2xl lg:overflow-y-auto lg:shadow-2xl lg:border lg:border-white/80';

const isHome =
  Astro.url.pathname === '/' ||
  Astro.url.pathname === '/en' ||
  Astro.url.pathname === '/en/' ||
  Astro.url.pathname === '';

const windowVisibility = isHome ? 'lg:hidden' : '';
---

<MainLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  schema={schema}
>
  <div class="w-full h-full overflow-x-clip flex justify-center">
    <div
      class="h-full w-[98%] lg:h-[98%] flex gap-4 flex-col lg:flex-row lg:justify-between"
    >
      <div
        class="hidden lg:flex lg:flex-col lg:h-full lg:gap-4 transition duration-400 -translate-x-animation"
        transition:persist="sidebar"
        data-left-animation
      >
        <MainCard data={mainCard} />
        <Contact data={contactData} platform="desktop" />
        <div class="contents">
          <FactSlider data={factSlider} />
        </div>
      </div>

      <slot name="header-bubble" />

      <div
        class=`${windowVisibility} w-full min-h-0 h-full lg:h-auto flex-1 scale-window transition-all duration-400 ${scrollStyling} flex flex-col gap-2 scrollbar-aero`
        id="main-window"
        data-zoom-animation
      >
        <slot />
      </div>

      <div
        class="hidden lg:block transition duration-400 translate-x-animation"
        transition:persist="menu"
        data-right-animation
      >
        <ContentList data={contentList} />
      </div>
    </div>
  </div>
</MainLayout>
