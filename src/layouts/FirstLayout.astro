---
import '@styles/main.css';

import { ClientRouter } from 'astro:transitions';

import type { Lang } from '../data';

const lang = (Astro.currentLocale ??
  (Astro.url.pathname.startsWith('/en') ? 'en' : 'es')) as Lang;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link rel="icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Portfolio</title>
    <ClientRouter />

    <script is:inline>
      (function () {
        if (window.location.pathname.startsWith('/en')) return;

        const browserLang =
          (navigator.languages && navigator.languages[0]) ||
          navigator.language ||
          '';
        const isSpanish = browserLang.toLowerCase().startsWith('es');

        if (!isSpanish) {
          const currentPath = window.location.pathname;
          const targetPath =
            '/en' +
            (currentPath === '/' ? '' : currentPath) +
            window.location.search;

          window.location.replace(targetPath);
        }
      })();
    </script>
  </head>
  <body
    class="min-h-dvh h-screen flex flex-col lg:justify-between items-center gap-4"
  >
    <slot />

    <script>
      import { startPage } from '@utils/startPage';
      import { generateAnimations } from '@utils/animation';

      document.addEventListener(
        'click',
        (event) => {
          const target = event.target;

          if (!(target instanceof Element)) return;

          const link = target.closest('a');

          if (!(link instanceof HTMLAnchorElement)) return;

          const currentUrl = new URL(window.location.href);
          const targetUrl = new URL(link.href);

          if (currentUrl.href === targetUrl.href) {
            event.preventDefault();
            event.stopImmediatePropagation();
          }
        },
        true
      );

      document.addEventListener('astro:page-load', startPage);
      document.addEventListener('DOMContentLoaded', generateAnimations);
    </script>
  </body>
</html>
