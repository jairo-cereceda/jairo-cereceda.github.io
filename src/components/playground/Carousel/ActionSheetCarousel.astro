---
import { Icon } from 'astro-icon/components';
import type { Lang } from '@data/index';

const lang = (Astro.currentLocale ??
  (Astro.url.pathname.startsWith('/en') ? 'en' : 'es')) as Lang;
---

<div
  id="action-sheet-carousel-wrapper"
  aria-hidden="true"
  class="absolute inset-0 overflow-hidden bg-black/40 z-50 opacity-0 pointer-events-none transition-opacity duration-300 rounded-2xl"
>
  <div
    class="absolute bottom-0 left-0 w-full max-h-[85%] px-4 py-6 bg-white text-black rounded-t-2xl shadow-lg translate-y-full transition-transform duration-300 z-10 overflow-y-auto"
    id="action-sheet-carousel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="action-sheet-carousel-title"
    aria-describedby="action-sheet-carousel-description"
  >
    <button
      id="action-sheet-carousel-closer"
      class="absolute top-2 right-2 cursor-pointer"
      aria-label={lang === 'es'
        ? 'Cerrar panel de información'
        : 'Close info pane'}
      tabindex="-1"
    >
      <Icon name="close" size="24" />
    </button>

    <h2
      class="text-center font-bold text-lg mb-3"
      id="action-sheet-carousel-title"
    >
    </h2>
    <p
      id="action-sheet-carousel-description"
      class="text-sm md:text-base leading-relaxed"
    >
    </p>
  </div>
</div>
