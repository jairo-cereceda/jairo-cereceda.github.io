---
import Image from 'astro/components/Image.astro';
import SlideMoreInfoBtn from './SlideMoreInfoBtn.astro';

export interface slideData {
  imgSrc: ImageMetadata;
  title: string;
  text: string;
}

export interface Props {
  data: slideData;
}

const { data } = Astro.props;
const { imgSrc, title, text } = data;
---

<div
  class="grid grid-cols-2 items-center gap-10 p-5 px-7 md:p-20 bg-white max-w-big"
>
  <Image
    src={imgSrc}
    alt=""
    widths={[160, 320, 600]}
    sizes={`(max-width: 768px) 160px, 600px`}
    loading="lazy"
    class="aspect-square object-cover rounded-2xl [box-shadow:0_0_2.5rem_0.16rem_var(--color-black)]"
  />
  <div class="flex flex-col gap-2 items-center justify-center xl:items-start">
    <h2 class="lg:text-4xl uppercase font-bold text-center xl:text-start">
      {title}
    </h2>
    <p class="hidden xl:block">{text}</p>
    <div class="xl:hidden">
      <SlideMoreInfoBtn data={{ title: title, description: text }} />
    </div>
  </div>
</div>
