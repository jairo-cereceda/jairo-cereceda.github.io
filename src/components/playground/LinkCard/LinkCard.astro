---
import { Image } from 'astro:assets';

export interface linkCardData {
  firstImgSrc: string;
  secondImgSrc?: string;
  title: string;
  url: string;
}

export interface Props {
  data: linkCardData;
}

const { data } = Astro.props;
const { url, firstImgSrc, secondImgSrc, title } = data;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpeg,jpg,png,gif,webp,JPG,PNG}'
);

const firstImagePath = `/src/assets/${firstImgSrc}`;
if (!allImages[firstImagePath]) {
  throw new Error(
    `Main image "${firstImagePath}" doesn't exist in src/assets/`
  );
}
const firstImage = allImages[firstImagePath]();

let secondImage = null;
if (secondImgSrc) {
  const secondImagePath = `/src/assets/${secondImgSrc}`;
  if (allImages[secondImagePath]) {
    secondImage = allImages[secondImagePath]();
  } else {
    console.warn(`Warn: The second image "${secondImagePath}" doesn't exist.`);
  }
}
---

<div class="flex items-center justify-center w-full">
  <div class="max-w-small">
    <a
      href={url}
      id="link-card"
      class="pointer-events-none group relative w-full rounded-2xl overflow-hidden"
    >
      <div class="relative w-full overflow-hidden">
        {
          secondImage && (
            <Image
              src={secondImage}
              width={600}
              height={600}
              loading="lazy"
              class="pointer-events-auto rounded-2xl absolute inset-0 w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-0 aspect-3/1 md:aspect-3/5"
              alt=""
            />
          )
        }
        <Image
          src={firstImage}
          loading="lazy"
          width={600}
          height={600}
          class="w-full object-cover rounded-2xl aspect-banner md:aspect-3/5"
          alt=""
        />
      </div>

      <h2
        class="absolute bottom-2 left-2 z-5 text-white font-bold rounded-2xl px-3 py-1 overflow-hidden"
      >
        <span class="relative z-5">{title}</span>
      </h2>
    </a>
  </div>
</div>

<script>
  document
    .querySelector('#link-card')
    ?.addEventListener('click', (e) => e.preventDefault());
</script>
