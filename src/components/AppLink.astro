---
import { Icon } from 'astro-icon/components';
import GlassWrapper from './GlassWrapper.astro';

export interface AppLinkData {
  url: string;
  icon: string;
  text: string;
}

export interface Props {
  data: AppLinkData;
}

const { data } = Astro.props;
const { url, icon, text } = data;

const isMailto = url.startsWith('mailto:');

const mailtoId = isMailto
  ? {
      id: 'mailto-btn',
    }
  : undefined;
---

<GlassWrapper padding={false}>
  {
    (
      <a
        href={!isMailto ? url : null}
        rel="noreferrer noopener"
        target="_blank"
        class="flex justify-between w-full p-6 cursor-pointer"
        {...mailtoId}
      >
        <div class="flex gap-4 text-white">
          <Icon name={icon} size={25} />
          {text}
        </div>

        <Icon name="arrow-right" size={25} class="text-white" />
      </a>
    )
  }
</GlassWrapper>

<script>
  document.getElementById('mailto-btn')?.addEventListener('click', (e) => {
    const user = 'jaiiro.cereceda';
    const domain = 'gmail.com';

    window.location.href = `mailto:${user}@${domain}`;
  });
</script>
