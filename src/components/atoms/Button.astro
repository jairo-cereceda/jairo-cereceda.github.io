---
export interface buttonData {
  text: string;
  isActionSheet?: boolean;
  actionSheetTitle?: string;
  actionSheetDescription?: string;
}

interface Props {
  data: buttonData;
}

const { data } = Astro.props;
const { text, isActionSheet, actionSheetTitle, actionSheetDescription } = data;

const isActionSheetAttributes = isActionSheet
  ? { 'data-action-sheet-btn': '' }
  : {};

const hasActionSheetTitle =
  actionSheetTitle && isActionSheet ? { 'data-title': actionSheetTitle } : {};

const hasActionSheetDescription =
  actionSheetDescription && isActionSheet
    ? { 'data-description': actionSheetDescription }
    : {};
---

<button
  class="px-3 py-2 bg-white/20 shadow-secondary/20 font-bold border border-white/20 rounded-2xl text-sm cursor-pointer"
  {...isActionSheetAttributes}
  {...hasActionSheetTitle}
  {...hasActionSheetDescription}
>
  {text}
</button>
