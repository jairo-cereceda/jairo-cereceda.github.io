---
import { Icon } from 'astro-icon/components';

export interface buttonData {
  text?: string;
  isMoreInfo?: boolean;
  moreInfoTitle?: string;
  moreInfoDescription?: string;
  isBackButton?: boolean;
}

interface Props {
  data: buttonData;
  buttonId?: string;
}

const { data, buttonId } = Astro.props;

const {
  text,
  isMoreInfo,
  moreInfoTitle,
  moreInfoDescription,
  isBackButton,
} = data;

const isMoreInfoAttributes = isMoreInfo
  ? { 'data-more-info-btn': '' }
  : {};

const hasMoreInfoTitle =
  moreInfoTitle && isMoreInfo ? { 'data-title': moreInfoTitle } : {};

const hasMoreInfoDescription =
  moreInfoDescription && isMoreInfo
    ? { 'data-description': moreInfoDescription }
    : {};

const backButtonAttributes = isBackButton ? { id: "back-button" } : {};

const baseStyles = "self-center px-3 py-2 bg-white/20 shadow-secondary/20 font-bold border border-white/20 rounded-2xl text-sm cursor-pointer"
---

{
!isBackButton ? 
  <button
  id={buttonId}
    class=`${baseStyles}`
    {...isMoreInfoAttributes}
    {...hasMoreInfoTitle}
    {...hasMoreInfoDescription}
  >

    {text}
  </button> 
  : 
  <a
  class=`${baseStyles} mx-2 flex items-center justify-center left-0 absolute`
  {...backButtonAttributes}
  >
  <Icon name="arrow-left"/>
  </a>

  <script>
    const backButton = document.getElementById("back-button");

    if(backButton){
      const path = window.location.pathname;

      backButton.setAttribute('href', path.substring(0, path.lastIndexOf('/')) || "/");
    }
  </script>
}

