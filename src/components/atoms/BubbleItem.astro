---
import { getImageMetadata } from '@utils/getImage';
import { Image } from 'astro:assets';
import Button from './Button.astro';
import type { Lang } from '@data/consts';

const lang = (Astro.currentLocale ??
  (Astro.url.pathname.startsWith('/en') ? 'en' : 'es')) as Lang;

export interface bubbleItemData {
  img: string;
  text: string;
  description: string;
}

export interface Props {
  data: bubbleItemData;
}

const { data } = Astro.props;
const { img, text, description } = data;

const metadata = await getImageMetadata(img);

const moreInfoButton = {
  text: lang === 'es' ? 'Ver más' : 'Show more',
  isMoreInfo: true,
  moreInfoTitle: text,
  moreInfoDescription: description,
};

const panelId = crypto.randomUUID();
const buttonId = crypto.randomUUID();
---

<div
  class="w-full px-4 py-2 backdrop-blur-md bg-secondary/20 rounded-2xl shadow-2xl shadow-white/20 border border-white/10 lg:flex gap-2 justify-between items-center lg:flex-col"
  data-more-info
>
  <div class="flex w-full justify-between">
    <div class="flex gap-2 items-center">
      <Image
        src={metadata}
        width={metadata.width}
        height={metadata.height}
        alt=""
        class="rounded-full w-16 h-16"
      />
      <p>{text}</p>
    </div>

    <Button data={moreInfoButton} buttonId={buttonId} />
  </div>

  <div
    id={panelId}
    role="region"
    aria-labelledby={buttonId}
    class="w-full max-h-0 transition-all duration-400 overflow-hidden"
    data-more-info-content
  >
    <p class="p-4">{description}</p>
  </div>
</div>
