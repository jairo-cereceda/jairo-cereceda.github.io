---
import { getImageMetadata } from '@utils/getImage';
import { Image } from 'astro:assets';

export interface bubbleItemData {
  img: string;
  text: string;
}

export interface Props {
  data: bubbleItemData;
}

const { data } = Astro.props;
const { img, text } = data;

const metadata = await getImageMetadata(img);
---

<div
  class="w-full px-4 py-2 backdrop-blur-md bg-secondary/20 rounded-2xl shadow-2xl shadow-white/20 border border-white/10 flex gap-2 items-center"
>
  <Image
    src={metadata}
    width={metadata.width}
    height={metadata.height}
    alt=""
    class="rounded-full w-16 h-16"
  />
  <p>{text}</p>
</div>
