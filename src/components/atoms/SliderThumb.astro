---
export interface sliderThumbData {
  ariaLabel: string;
  id: number;
}

export interface Props {
  data: sliderThumbData;
}

const { data } = Astro.props;
const { ariaLabel, id } = data;
---

<button
  aria-label={ariaLabel}
  class="bg-transparent rounded-full w-2.5 h-2.5 cursor-pointer border border-white"
  data-slider-thumb={id}
>
</button>
