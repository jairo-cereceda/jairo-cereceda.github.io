---
import { Icon } from 'astro-icon/components';
import Link from './Link.astro';

export interface headerItemData {
  url: string;
  text: string;
  icon?: string;
  visibleText: boolean;
}

export interface Props {
  data: headerItemData;
}

const { data } = Astro.props;
const { text, url, icon, visibleText } = data;

const itemAttrs = !visibleText ? { 'aria-label': text } : {};
---

<li>
  <Link href={url} {...itemAttrs}>
    {icon && <Icon name={icon} size={16} />}
    {visibleText && text}
  </Link>
</li>
