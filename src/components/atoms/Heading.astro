---
import Button, { type buttonData } from './Button.astro';

export interface Props {
  text: string;
  type: 'bubble' | 'full';
}

const { text, type } = Astro.props;
let style;

switch (type) {
  case 'bubble':
    style =
      'top-12 right-5 -translate-y-2 z-10 absolute py-1 lg:top-12 lg:left-100 xl:left-150 lg:right-auto transition duration-400 scale-title';
    break;

  case 'full':
    style = 'w-full relative py-2';
    break;
}
---

<h1
  class=`${style} outline-none lg:z-100 backdrop-blur-md rounded-2xl px-4 font-bold  shadow-2xl shadow-white/20 border border-white/10 flex gap-1 justify-center items-center drop-shadow-[0_0_1px_rgba(255,255,255,0.5)] filter`
  tabindex="-1"
>
  {type === 'full' && <Button data={{ isBackButton: true }} />}
  {text}
</h1>
