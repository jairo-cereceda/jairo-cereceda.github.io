---
export interface Props {
  text: string;
}

const { text } = Astro.props;
---

<h1
  class="top-12 right-5 -translate-y-2 z-10 absolute backdrop-blur-md rounded-2xl px-4 font-bold py-1 shadow-2xl shadow-white/20 border border-white/10 flex gap-1 justify-center items-center drop-shadow-[0_0_1px_rgba(255,255,255,0.5)] filter"
>
  {text}
</h1>
