---
import type { Lang } from '@data/consts';
import { getImageMetadata } from '@utils/getImage';
import { Image } from 'astro:assets';

const lang = (Astro.currentLocale ??
  (Astro.url.pathname.startsWith('/en') ? 'en' : 'es')) as Lang;

export interface ProjectCoverData {
  img: string;
  title: string;
}

export interface Props {
  id: number;
  data: ProjectCoverData;
}

const { data, id } = Astro.props;
const { img, title } = data;

const metadata = await getImageMetadata(img);
---

<button
  aria-label={lang === 'es' ? `Ir a ${title}` : `Go to ${title}`}
  class="bg-transparent rounded-2xl flex justify-between items-center pr-2 border border-white/20 transition duration-150 hover:border-white/60 cursor-pointer"
  data-slider-thumb={id}
>
  <Image
    src={metadata}
    width={metadata.width}
    height={metadata.height}
    alt=""
    class="bg-white w-16 h-16 rounded-2xl object-fit"
  />
  <p>{title}</p>
</button>
