---
import SliderThumb from '@components/atoms/SliderThumb.astro';
import type { Lang } from '@data/consts';

const lang = (Astro.currentLocale ??
  (Astro.url.pathname.startsWith('/en') ? 'en' : 'es')) as Lang;

export interface sliderTrackData {
  quantity: number;
  position: 'top' | 'bottomRight' | 'verticalMiddle';
}

export interface Props {
  data: sliderTrackData;
}

const { data } = Astro.props;
const { quantity, position } = data;

let stylePosition;
switch (position) {
  case 'top':
    stylePosition = 'top-0 left-1/3 -translate-x-1/2 -translate-y-2 px-2 py-1';
    break;
  case 'bottomRight':
    stylePosition = 'bottom-8 right-4 px-2 py-1';
    break;
  case 'verticalMiddle':
    stylePosition =
      'flex-col top-1/2 -translate-y-1/2 right-2 px-0.5 py-2 bg-secondary/50 sm:max-md:flex-row sm:max-md:bottom-2 sm:max-md:top-auto sm:max-md:right-auto sm:max-md:left-1/2 sm:max-md:-translate-x-1/2 sm:max-md:-translate-y-2 sm:max-md:px-2 sm:max-md:py-1 xl:flex-row xl:bottom-2 xl:top-auto xl:right-auto xl:left-1/2 xl:-translate-x-1/2 xl:-translate-y-2 xl:px-2 xl:py-1';
}
---

<div
  class={`z-10 absolute ${stylePosition} backdrop-blur-md filter rounded-2xl shadow-2xl shadow-white/20 border border-white/10 flex gap-4 justify-center items-center`}
>
  {
    [...Array(quantity)].map((_, id) => (
      <SliderThumb
        data={{
          ariaLabel:
            lang === 'es' ? `Ir a la diapositiva ${id}` : `Go to slide ${id}`,
          id: id,
        }}
      />
    ))
  }
</div>
