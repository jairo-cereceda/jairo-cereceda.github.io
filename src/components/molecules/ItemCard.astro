---
import DefaultCard from '@components/molecules/DefaultCard.astro';
import { Icon } from 'astro-icon/components';

export interface itemCardData {
  url: string;
  icon?: string;
  text: string;
}

export interface Props {
  data: itemCardData;
}

const { data } = Astro.props;
const { url, icon, text } = data;
---

<a href={url} data-page>
  <DefaultCard>
    <div class="flex flex-col justify-between">
      <Icon name={icon} size="48" class="lg:w-8" />
      <h2 class="font-bold">{text}</h2>
    </div>
  </DefaultCard>
</a>
