---
import { Icon } from 'astro-icon/components';
import DefaultCard from './DefaultCard.astro';
import type { Lang } from '@data/consts';

const lang = (Astro.currentLocale ??
  (Astro.url.pathname.startsWith('/en') ? 'en' : 'es')) as Lang;

export interface projectInfoData {
  title: string;
  description: string[];
  projectUrl?: string;
  repositoryUrl?: string;
}

export interface Props {
  data: projectInfoData;
}

const { data } = Astro.props;
const { title, description, projectUrl, repositoryUrl } = data;
---

<div class="absolute z-10 h-full w-full max-h-[55%] bottom-0 xl:max-h-[45%]">
  <DefaultCard isFullheight={true}>
    <div class="flex flex-col h-full min-h-0">
      <div class="flex shrink-0 items-center justify-between gap-2 pb-2">
        <h2 class="font-extrabold text-lg">{title}</h2>

        <div class="flex gap-2 items-center">
          {
            projectUrl && (
              <a
                href={projectUrl}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={lang === 'es' ? 'Ver proyecto' : 'View project'}
                class="text-sm flex gap-2 items-center rounded-full p-2 bg-white text-black transition duration-200 hover:drop-shadow-[0_0_2px_rgba(255,255,255,1)] hover:filter"
              >
                <Icon name="eye" size={16} class="text-primary" />
              </a>
            )
          }

          {
            repositoryUrl && (
              <a
                href={repositoryUrl}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={
                  lang === 'es' ? 'Ver repositorio' : 'View repository'
                }
                class="text-sm flex gap-2 items-center rounded-full p-2 bg-white text-black transition duration-200 hover:drop-shadow-[0_0_2px_rgba(255,255,255,1)] hover:filter"
              >
                <Icon name="repository" size={16} class="text-primary" />
              </a>
            )
          }
        </div>
      </div>

      <div class="flex flex-1 flex-col gap-2 overflow-y-auto min-h-0">
        {description.map((text) => <p>{text}</p>)}
      </div>
    </div>
  </DefaultCard>
</div>
