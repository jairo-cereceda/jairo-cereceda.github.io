---
import DefaultCard from './DefaultCard.astro';
import Image, { type imageData } from '@components/atoms/Image.astro';

export interface projectSlideImgsData {
  imgs: imageData[];
}

export interface Props {
  data: projectSlideImgsData;
}

const { data } = Astro.props;
const { imgs } = data;
---

<DefaultCard isFullheight={true} class="max-h-[50%] xl:max-h-[60%]">
  <div class="overflow-hidden h-full" data-slider-wrapper>
    <div
      class="overflow-hidden snap-x snap-mandatory scrollbar-none [&::-webkit-scrollbar]:hidden h-full w-full flex"
      data-slider
      data-is-autoplayable="true"
    >
      <div
        class="w-full h-full shrink-0 flex snap-center snap-always justify-center"
        data-slide
      >
        <Image data={imgs[imgs.length - 1]} />
      </div>
      {
        imgs.map((img) => (
          <div
            class="w-full h-full shrink-0  snap-center snap-always flex justify-center"
            data-slide
          >
            <Image data={img} />
          </div>
        ))
      }
      <div
        class="w-full h-full shrink-0 snap-center snap-always flex justify-center"
        data-slide
      >
        <Image data={imgs[0]} />
      </div>
    </div>
  </div>
</DefaultCard>
