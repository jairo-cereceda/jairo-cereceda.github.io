---
import DefaultCard from './DefaultCard.astro';
import Image, { type projectSlideImgData } from '@components/atoms/Image.astro';

export interface projectSlideImgsData {
  imgs: projectSlideImgData[];
}

export interface Props {
  data: projectSlideImgsData;
}

const { data } = Astro.props;
const { imgs } = data;
---

<DefaultCard isFullheight={false}>
  <div class="overflow-hidden">
    <div
      class="flex w-full h-full"
      data-slider
      data-is-manegeable="false"
      data-is-autoplayable="true"
    >
      <div class="w-full shrink-0 flex justify-center" data-slide>
        <Image data={imgs[imgs.length - 1]} />
      </div>
      {
        imgs.map((img) => (
          <div class="w-full shrink-0 flex justify-center" data-slide>
            <Image data={img} />
          </div>
        ))
      }
      <div class="w-full shrink-0 flex justify-center" data-slide>
        <Image data={imgs[0]} />
      </div>
    </div>
  </div>
</DefaultCard>
