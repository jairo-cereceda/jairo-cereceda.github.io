---
import Link from '@components/atoms/Link.astro';
import { Icon } from 'astro-icon/components';

export interface appLinkData {
  url: string;
  icon: string;
  text: string;
}

export interface Props {
  data: appLinkData;
  span?: boolean;
}

const { data, span } = Astro.props;
const { url, icon, text } = data;

const isMailto = url.startsWith('mailto:');

const mailtoId = isMailto
  ? {
      id: 'mailto-btn',
      tabindex: '0',
    }
  : undefined;

const colSpan = span ? 'col-span-2' : '';
---

<Link
  href={!isMailto ? url : ''}
  rel="noreferrer noopener"
  target="_blank"
  class=`bg-white/20 shadow-secondary/20 font-bold border border-white/20 rounded-2xl text-sm ${colSpan}
        flex justify-between items-center w-full p-6 cursor-pointer lg:px-2 lg:py-2 xl:py-3 transition duration-200 hover:drop-shadow-[0_0_1px_rgba(255,255,255,0.25)] hover:filter`
  {...mailtoId}
>
  <div
    class="flex items-center gap-4 lg:gap-0.5 xl:gap-4 text-white font-bold drop-shadow-[0_0_1px_rgba(0,0,0,1)] filter"
  >
    <Icon name={icon} size={25} />
    {text}
  </div>

  <Icon
    name="arrow-right"
    size={25}
    class="text-white drop-shadow-[0_0_1px_rgba(0,0,0,1)] filter"
  />
</Link>

<script>
  document.getElementById('mailto-btn')?.addEventListener('click', (e) => {
    const user = 'jaiiro.cereceda';
    const domain = 'gmail.com';

    window.location.href = `mailto:${user}@${domain}`;
  });
</script>
