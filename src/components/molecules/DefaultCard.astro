---
export interface Props {
  isFullheight?: boolean;
  padding?: 'min' | 'medium' | 'max';
}

const { isFullheight = true, padding = 'max' } = Astro.props;

let paddingConfig;
switch (padding) {
  case 'min':
    paddingConfig = 'px-1 py-2';
    break;
  case 'medium':
    paddingConfig = 'px-4 py-4';
    break;
  case 'max':
    paddingConfig = 'px-4 py-8';
}
---

<div
  class={`backdrop-blur-md bg-secondary/20 rounded-2xl shadow-2xl shadow-white/20 border border-white/10 w-full ${paddingConfig} ${isFullheight ? 'h-full' : ''}`}
>
  <slot />
</div>
