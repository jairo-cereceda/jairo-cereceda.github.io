---
import ProjectInfo from '@components/molecules/ProjectInfo.astro';
import ProjectSlideImgs from '@components/molecules/ProjectSlideImgs.astro';
import SliderTrack from '@components/molecules/SliderTrack.astro';
import ProjectsTrack from '@components/molecules/ProjectsTrack.astro';

const slides = [
  {
    imgs: [
      {
        img: 'img/pfp.png',
        imgAlt: '',
      },
      {
        img: 'img/mock.png',
        imgAlt: '',
      },
    ],
    info: {
      title: 'Portfolio de Ilustradora',
      description: 'lorem ipsum',
    },
  },
  {
    imgs: [
      {
        img: 'img/pfp.png',
        imgAlt: '',
      },
      {
        img: 'img/mock.png',
        imgAlt: '',
      },
    ],
    info: {
      title: 'Portfolio de Ilustradora 2',
      description: 'lorem ipsum',
    },
  },
];

const projectsTrackData = {
  items: [
    {
      img: 'img/pfp.png',
      title: 'MyChat',
    },
    {
      img: 'img/pfp.png',
      title: 'MyChat',
    },
  ],
};
---

<section
  class="w-full h-full relative lg:grid lg:grid-cols-[30%_70%]"
  data-slider-wrapper
>
  <div class="lg:hidden">
    <SliderTrack data={{ quantity: slides.length, position: 'top' }} />
  </div>
  <div class="hidden lg:block">
    <ProjectsTrack data={projectsTrackData} />
  </div>
  <div class="w-full h-full overflow-hidden relative lg:col-start-2">
    <div class="overflow-hidden min-w-0 h-full rounded-2xl">
      <div
        class="overflow-x-auto snap-x snap-mandatory scrollbar-none [&::-webkit-scrollbar]:hidden h-full w-full flex"
        data-slider
        data-is-manegeable="true"
        data-is-autoplayable="false"
      >
        <article
          class="w-full relative shrink-0 snap-center snap-always flex justify-center"
          data-slide
        >
          <ProjectSlideImgs data={{ imgs: slides[slides.length - 1].imgs }} />
          <ProjectInfo data={slides[slides.length - 1].info} />
        </article>
        {
          slides.map((slide) => (
            <article
              class="w-full relative shrink-0 snap-center snap-always flex justify-center"
              data-slide
            >
              <ProjectSlideImgs data={{ imgs: slide.imgs }} />
              <ProjectInfo data={slide.info} />
            </article>
          ))
        }
        <article
          class="w-full relative shrink-0 snap-center snap-always flex justify-center"
          data-slide
        >
          <ProjectSlideImgs data={{ imgs: slides[0].imgs }} />
          <ProjectInfo data={slides[0].info} />
        </article>
      </div>
    </div>
  </div>
</section>
