---
import DefaultCard from '@components/molecules/DefaultCard.astro';
import { getImageMetadata } from '@utils/getImage';
import { Image } from 'astro:assets';

export interface mainCardData {
  img: string;
  imgAlt: string;
  name: string;
  profession: string;
}

export interface Props {
  data: mainCardData;
}

const { data } = Astro.props;
const { img, imgAlt, name, profession } = data;

const metadata = await getImageMetadata(img);
---

<section class="w-full">
  <DefaultCard>
    <div class="flex items-center justify-between">
      <Image
        src={metadata}
        width={metadata.width}
        height={metadata.height}
        alt={imgAlt}
        class="rounded-full w-24 h-24 drop-shadow-[0_0_2px_rgba(255,255,255,1)] filter"
      />

      <div class="flex flex-col gap-2">
        <h1
          class="font-bold text-white drop-shadow-[0_0_1px_rgba(255,255,255,1)] filter"
        >
          {name}
        </h1>
        <p
          class="font-extrabold text-white text-sm tracking-tighter drop-shadow-[0_0_.5px_rgba(255,255,255,1)] filter"
        >
          {profession}
        </p>
      </div>
    </div>
  </DefaultCard>
</section>
