---
import Button from '@components/atoms/Button.astro';
import DefaultCard from '@components/molecules/DefaultCard.astro';
import { getImageMetadata } from '@utils/getImage';
import { Image } from 'astro:assets';

export interface mainCardData {
  img: string;
  imgAlt: string;
  name: string;
  profession: string;
}

export interface Props {
  data: mainCardData;
}

const { data } = Astro.props;
const { img, imgAlt, name, profession } = data;

const metadata = await getImageMetadata(img);

const contactButton = {
  text: 'Contacto',
  isMoreInfo: true,
  moreInfoTitle: 'Contacto',
};

const isHome =
  Astro.url.pathname === '/' ||
  Astro.url.pathname === '/en' ||
  Astro.url.pathname === '/en/' ||
  Astro.url.pathname === '';

const titleStyles = {
  class: 'font-bold drop-shadow-[0_0_1px_rgba(255,255,255,1)] filter',
};
---

<section class="w-full lg:max-w-small xl:max-w-medium-small">
  <DefaultCard>
    <div class="flex items-center lg:flex-col xl:flex-row justify-between">
      <Image
        src={metadata}
        width={metadata.width}
        height={metadata.height}
        alt={imgAlt}
        class="rounded-full w-24 h-24 drop-shadow-[0_0_2px_rgba(255,255,255,1)] filter object-cover"
      />

      <div class="flex flex-col gap-2">
        {
          isHome ? (
            <h1 data-main-card-heading {...titleStyles}>
              {name}
            </h1>
          ) : (
            <h2 data-main-card-heading {...titleStyles}>
              {name}
            </h2>
          )
        }

        <div class="flex gap-2 items-center lg:justify-center xl:justify-end">
          <p
            class="font-extrabold text-sm tracking-tighter drop-shadow-[0_0_.5px_rgba(255,255,255,1)] filter"
          >
            {profession}
          </p>

          <div class="md:hidden">
            <Button data={contactButton}> Contacto </Button>
          </div>
        </div>
      </div>
    </div>
  </DefaultCard>
</section>

<script>
  document.addEventListener('astro:before-swap', (e) => {
    const event = e as any;
    const currentHeading = document.querySelector('[data-main-card-heading]');
    const newHeading = event.newDocument?.querySelector(
      '[data-main-card-heading]'
    );

    if (currentHeading && newHeading) {
      currentHeading.replaceWith(newHeading.cloneNode(true));
    }
  });
</script>
