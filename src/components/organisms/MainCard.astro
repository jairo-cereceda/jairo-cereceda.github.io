---
import Button from '@components/atoms/Button.astro';
import DefaultCard from '@components/molecules/DefaultCard.astro';
import { getImageMetadata } from '@utils/getImage';
import { Image } from 'astro:assets';

export interface mainCardData {
  img: string;
  imgAlt: string;
  name: string;
  profession: string;
}

export interface Props {
  data: mainCardData;
}

const { data } = Astro.props;
const { img, imgAlt, name, profession } = data;

const metadata = await getImageMetadata(img);

const contactButton = {
  text: 'Contacto',
  isActionSheet: true,
  actionSheetTitle: 'Contacto',
};
---

<section class="w-full lg:max-w-medium-small">
  <DefaultCard>
    <div class="flex items-center justify-between">
      <Image
        src={metadata}
        width={metadata.width}
        height={metadata.height}
        alt={imgAlt}
        class="rounded-full w-24 h-24 drop-shadow-[0_0_2px_rgba(255,255,255,1)] filter"
      />

      <div class="flex flex-col gap-2">
        <h1 class="font-bold drop-shadow-[0_0_1px_rgba(255,255,255,1)] filter">
          {name}
        </h1>

        <div class="flex gap-2 items-center lg:justify-end">
          <p
            class="font-extrabold text-sm tracking-tighter drop-shadow-[0_0_.5px_rgba(255,255,255,1)] filter"
          >
            {profession}
          </p>

          <div class="lg:hidden">
            <Button data={contactButton}> Contacto </Button>
          </div>
        </div>
      </div>
    </div>
  </DefaultCard>
</section>
