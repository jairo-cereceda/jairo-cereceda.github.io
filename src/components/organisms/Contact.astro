---
import AppLink from '@components/molecules/AppLink.astro';
import type { appLinkData } from '@components/molecules/AppLink.astro';
import ActionSheet from '@components/molecules/ActionSheet.astro';
import DefaultCard from '@components/molecules/DefaultCard.astro';

export interface contactData {
  items: appLinkData[];
}

export interface Props {
  data: contactData;
  platform: 'desktop' | 'mobile';
}

const { data, platform } = Astro.props;
const { items } = data;
---

{
  platform === 'mobile' ? (
    <ActionSheet hasTitle={true}>
      <div class="flex flex-col gap-2">
        {items.map((item) => (
          <AppLink data={item} />
        ))}
      </div>
    </ActionSheet>
  ) : (
    <DefaultCard
      padding="medium"
      isFullheight={false}
      class="max-w-small xl:max-w-none h-full lg:h-auto"
    >
      <article class="flex flex-col h-full lg:grid lg:grid-cols-2 xl:flex xl:flex-row gap-2 justify-between">
        {items.map((item, index) => (
          <AppLink data={item} span={index === 2 ? true : false} />
        ))}
      </article>
    </DefaultCard>
  )
}
