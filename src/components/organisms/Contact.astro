---
import AppLink from '@components/molecules/AppLink.astro';
import type { appLinkData } from '@components/molecules/AppLink.astro';
import ActionSheet from '@components/molecules/ActionSheet.astro';
import DefaultCard from '@components/molecules/DefaultCard.astro';

export interface contactData {
  items: appLinkData[];
}

export interface Props {
  data: contactData;
}

const { data } = Astro.props;
const { items } = data;
---

<div class="lg:hidden">
  <ActionSheet hasTitle={true}>
    <div class="flex flex-col gap-2">
      {items.map((item) => <AppLink data={item} />)}
    </div>
  </ActionSheet>
</div>

<div class="hidden lg:block">
  <DefaultCard padding="medium">
    <article class="flex gap-2 justify-between">
      {items.map((item) => <AppLink data={item} />)}
    </article>
  </DefaultCard>
</div>
