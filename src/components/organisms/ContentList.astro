---
import type { itemCardData } from '@components/molecules/ItemCard.astro';
import ItemCard from '@components/molecules/ItemCard.astro';

export interface contentListData {
  items: itemCardData[];
}

export interface Props {
  data: contentListData;
}

const { data } = Astro.props;
const { items } = data;
---

<section
  class="w-full grid grid-cols-2 gap-4 sm:w-auto sm:flex sm:flex-col sm:justify-between sm:h-full"
>
  {items.map((item) => <ItemCard data={item} />)}
</section>
