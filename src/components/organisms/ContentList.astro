---
import type { sectionCardData } from '@components/molecules/SectionCard.astro';
import SectionCard from '@components/molecules/SectionCard.astro';

export interface contentListData {
  items: sectionCardData[];
}

export interface Props {
  data: contentListData;
}

const { data } = Astro.props;
const { items } = data;
---

<section
  class="w-full grid grid-cols-2 gap-4 sm:w-auto sm:flex sm:flex-col sm:justify-between sm:h-full"
>
  {items.map((item) => <SectionCard data={item} />)}
</section>
