---
import DefaultCard from '@components/molecules/DefaultCard.astro';
import type { factCardData } from '@components/molecules/FactCard.astro';
import FactCard from '@components/molecules/FactCard.astro';
import SliderTrack from '@components/molecules/SliderTrack.astro';

export interface factSliderData {
  items: factCardData[];
}

export interface Props {
  data: factSliderData;
}

const { data } = Astro.props;
const { items } = data;
---

<section
  class="h-full w-full md:min-w-0 md:flex-1 lg:max-w-small xl:max-w-medium-small"
  data-slider-wrapper
>
  <DefaultCard>
    <SliderTrack data={{ quantity: items.length, position: 'bottomRight' }} />

    <div
      class="overflow-x-auto snap-x snap-mandatory scrollbar-none [&::-webkit-scrollbar]:hidden h-full w-full flex"
      data-slider
      data-is-autoplayable="true"
    >
      <article
        class="w-full shrink-0 snap-center snap-always flex justify-center"
        data-slide
      >
        <FactCard data={items[items.length - 1]} />
      </article>
      {
        items.map((card) => (
          <article
            class="w-full shrink-0 snap-center snap-always flex justify-center"
            data-slide
          >
            <FactCard data={card} />
          </article>
        ))
      }
      <article
        class="w-full shrink-0 snap-center snap-always flex justify-center"
        data-slide
      >
        <FactCard data={items[0]} />
      </article>
    </div>
  </DefaultCard>
</section>
