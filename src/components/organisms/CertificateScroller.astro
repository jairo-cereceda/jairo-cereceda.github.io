---
import type { imageData } from '@components/atoms/Image.astro';
import DefaultCard from '@components/molecules/DefaultCard.astro';
import SliderTrack from '@components/molecules/SliderTrack.astro';
import { getImageMetadata } from '@utils/getImage';
import { Image } from 'astro:assets';

export interface certificateScrollerData {
  imgs: imageData[];
  title?: string;
}

export interface Props {
  data: certificateScrollerData;
}

const { data } = Astro.props;
const { imgs, title } = data;

const imgMetadatas: any[] = [];

for (const img of imgs) {
  imgMetadatas.push({
    img: await getImageMetadata(img.img),
    imgAlt: img.imgAlt,
  });
}
---

<section class="w-full sm:h-full lg:h-auto" data-scroller-wrapper>
  <DefaultCard isFullheight={false} class="sm:h-full">
    {
      title ? (
        <h2 class="font-bold drop-shadow-[0_0_1px_rgba(255,255,255,0.5)] filter text-lg">
          {title}
        </h2>
      ) : (
        ''
      )
    }
    <div class="overflow-hidden sm:h-full">
      <SliderTrack
        data={{ quantity: imgMetadatas.length, position: 'verticalMiddle' }}
      />
      <div class="flex w-full h-full touch-none" data-scroller>
        {
          imgMetadatas.map((img) => (
            <div
              class="flex-none w-full sm:h-full relative overflow-hidden rounded-xl"
              data-slide
            >
              <Image
                src={img.img}
                width={img.img.width}
                height={img.img.height}
                alt=""
                aria-hidden="true"
                class="hidden sm:max-lg:block absolute inset-0 w-full h-full object-cover blur-md scale-110 brightness-90"
              />

              <Image
                src={img.img}
                width={img.img.width}
                height={img.img.height}
                alt={img.imgAlt}
                class={`
            w-full aspect-video object-cover sm:h-full
            sm:max-lg:aspect-auto
            sm:max-lg:object-contain
            sm:max-lg:object-center
            relative z-10
          `}
              />
            </div>
          ))
        }
      </div>
    </div>
  </DefaultCard>
</section>
