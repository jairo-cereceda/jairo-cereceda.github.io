---
import DefaultCard from '@components/molecules/DefaultCard.astro';
import MainLayout from '@layouts/MainLayout.astro';
---

<MainLayout>
  <article class="w-full my-auto flex justify-center">
    <DefaultCard isFullheight={true} class="lg:max-w-medium-small">
      <div class="flex flex-col gap-4 w-full h-full items-center">
        <h1 class="text-2xl text-center font-bold">
          Parece que te has perdido
        </h1>

        <p
          class="text-center text-lg drop-shadow-[0_0_1px_rgba(255,255,255,0.5)] filter"
        >
          ¡Oye! Mi portfolio creo que ya aporta suficiente valor como para
          buscar por otras urls.
        </p>

        <a
          href="/"
          class="self-center px-3 py-2 bg-white/20 shadow-secondary/20 font-bold border border-white/20 rounded-2xl text-sm cursor-pointer"
          >Visitar mi portfolio</a
        >
      </div>
    </DefaultCard>
  </article>
</MainLayout>
