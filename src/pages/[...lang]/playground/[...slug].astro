---
import Heading from '@components/atoms/Heading.astro';
import { getPlaygroundItemSchema } from '@data/es/playground';
import { getPlaygroundDescription, getPlaygroundTitle } from '@data/index';
import PortfolioLayout from '@layouts/PortfolioLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('playground');

  return docs.map((doc) => {
    const [lang, ...slugParts] = doc.id.split('/');

    const cleanSlug = slugParts.join('/').replace(/\.mdx?$/, '');

    return {
      params: {
        lang: lang === 'es' ? undefined : 'en',
        slug: cleanSlug,
      },
      props: {
        doc,
        slug: cleanSlug,
      },
    };
  });
}

const { doc, slug } = Astro.props;
const { Content } = await render(doc);

const baseSectionTitle = getPlaygroundTitle(doc.data.lang);
const pageTitle = `${doc.data.title} | ${baseSectionTitle}`;
const pageDescription =
  doc.data.description ?? getPlaygroundDescription(doc.data.lang);

const schema = getPlaygroundItemSchema({
  title: doc.data.title,
  description: pageDescription,
  slug,
  lang: doc.data.lang,
});
---

<PortfolioLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  schema={schema}
>
  <div class="w-full h-full flex flex-col gap-2">
    <Heading text={doc.data.title} type="full" />
    <div
      class="rounded-2xl p-2 border border-white/20 backdrop-blur-md w-full h-full shadow-secondary/20"
    >
      <div
        class="rounded-2xl bg-white/60 w-full relative h-full overflow-hidden"
      >
        <Content />
      </div>
    </div>
  </div>
</PortfolioLayout>
