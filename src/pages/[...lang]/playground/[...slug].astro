---
// src/pages/[...lang]/playground/[...slug].astro
import Heading from '@components/atoms/Heading.astro';
import PortfolioLayout from '@layouts/PortfolioLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('playground');

  return docs.map((doc) => {
    // doc.id suele ser "es/nombre.mdx" o "en/nombre.mdx"
    const [lang, ...slugParts] = doc.id.split('/');

    // Limpiamos la extensión para que la URL sea limpia (ej: "boton" en vez de "boton.mdx")
    const cleanSlug = slugParts.join('/').replace(/\.mdx?$/, '');

    return {
      params: {
        // Si es español, 'undefined' lo deja en /playground/[slug]
        // Si es inglés, genera /en/playground/[slug]
        lang: lang === 'es' ? undefined : 'en',
        slug: cleanSlug,
      },
      props: {
        doc,
      },
    };
  });
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<PortfolioLayout>
  <div class="w-full h-full flex flex-col gap-2">
    <Heading text={doc.data.title} type="full" />
    <div
      class="rounded-2xl p-2 border border-white/20 backdrop-blur-md w-full h-full shadow-secondary/20"
    >
      <div class="rounded-2xl bg-white/60 w-full h-full">
        <Content />
      </div>
    </div>
  </div>
</PortfolioLayout>
