---
import Heading from '@components/atoms/Heading.astro';
import ComponentCardList from '@components/organisms/ComponentCardList.astro';
import PortfolioLayout from '@layouts/PortfolioLayout.astro';
import {
  getComponentsData,
  getPlaygroundDescription,
  getPlaygroundSchema,
  getPlaygroundTitle,
} from '@data/index';
import type { Lang } from '@data/consts';

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { lang: 'es' as Lang } },
    { params: { lang: 'en' }, props: { lang: 'en' as Lang } },
  ];
}

const { lang } = Astro.props;

const components = getComponentsData(lang);
const pageTitle = getPlaygroundTitle(lang);
const pageDescription = getPlaygroundDescription(lang);
const schema = getPlaygroundSchema(lang);
---

<PortfolioLayout
  isScrollable={true}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  schema={schema}
>
  <Heading
    slot="header-bubble"
    text={lang === 'es' ? 'Laboratorio' : 'Playground'}
    type="bubble"
  />
  <ComponentCardList data={components} />
</PortfolioLayout>
