---
import Heading from '@components/atoms/Heading.astro';
import ComponentCardList from '@components/organisms/ComponentCardList.astro';
import PortfolioLayout from '@layouts/PortfolioLayout.astro';
import { getComponentsData, type Lang } from '@data/index';

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { lang: 'es' as Lang } },
    { params: { lang: 'en' }, props: { lang: 'en' as Lang } },
  ];
}

const { lang } = Astro.props;

const components = getComponentsData(lang);
---

<PortfolioLayout isScrollable={true}>
  <Heading
    slot="header-bubble"
    text={lang === 'es' ? 'Laboratorio' : 'Playground'}
    type="bubble"
  />
  <ComponentCardList data={components} />
</PortfolioLayout>
