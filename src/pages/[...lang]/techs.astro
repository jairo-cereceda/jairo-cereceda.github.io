---
import Heading from '@components/atoms/Heading.astro';
import ActionSheet from '@components/molecules/ActionSheet.astro';
import BubbleItemList from '@components/organisms/BubbleItemList.astro';
import PortfolioLayout from '@layouts/PortfolioLayout.astro';
import { getTechsData, type Lang } from '@data/index';

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { lang: 'es' as Lang } },
    { params: { lang: 'en' }, props: { lang: 'en' as Lang } },
  ];
}

const { lang } = Astro.props;

const techs = getTechsData(lang);
---

<PortfolioLayout isScrollable={true}>
  <Heading slot="header-bubble" text="Tecnologías" type="bubble" />
  <BubbleItemList data={techs} />
  <div class="lg:hidden">
    <ActionSheet hasTitle={true} hasDescription={true} />
  </div>
</PortfolioLayout>
