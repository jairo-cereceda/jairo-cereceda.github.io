---
import Heading from '@components/atoms/Heading.astro';
import ActionSheet from '@components/molecules/ActionSheet.astro';
import BubbleItemList from '@components/organisms/BubbleItemList.astro';
import PortfolioLayout from '@layouts/PortfolioLayout.astro';
import {
  getTechsData,
  getTechsDescription,
  getTechsSchema,
  getTechsTitle,
} from '@data/index';
import type { Lang } from '@data/consts';

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { lang: 'es' as Lang } },
    { params: { lang: 'en' }, props: { lang: 'en' as Lang } },
  ];
}

const { lang } = Astro.props;

const techs = getTechsData(lang);
const pageTitle = getTechsTitle(lang);
const pageDescription = getTechsDescription(lang);
const schema = getTechsSchema(lang);
---

<PortfolioLayout
  isScrollable={true}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  schema={schema}
>
  <Heading
    slot="header-bubble"
    text={lang === 'es' ? 'Tecnologías' : 'Techs'}
    type="bubble"
  />
  <BubbleItemList data={techs} />
  <div class="lg:hidden">
    <ActionSheet hasTitle={true} hasDescription={true} />
  </div>
</PortfolioLayout>
