---
import Contact from '@components/organisms/Contact.astro';
import ContentList from '@components/organisms/ContentList.astro';
import FactSlider from '@components/organisms/FactSlider.astro';
import MainCard from '@components/organisms/MainCard.astro';
import PortfolioLayout from '@layouts/PortfolioLayout.astro';
import {
  getMainCardData,
  getContentListData,
  getFactSliderData,
  getContactData,
  getIndexTitle,
  getIndexDescription,
  getIndexSchema,
} from '@data/index';
import type { Lang } from '@data/consts';

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { lang: 'es' as Lang } },
    { params: { lang: 'en' }, props: { lang: 'en' as Lang } },
  ];
}

const { lang } = Astro.props;

const mainCard = getMainCardData(lang);
const contentList = getContentListData(lang);
const factSlider = getFactSliderData(lang);
const contactData = getContactData(lang);
const pageTitle = getIndexTitle(lang);
const pageDescription = getIndexDescription(lang);
const schema = getIndexSchema(lang);
---

<PortfolioLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  schema={schema}
>
  <div class="w-full h-full lg:hidden flex gap-4 flex-col">
    <MainCard data={mainCard} />
    <div class="absolute lg:hidden">
      <Contact data={contactData} platform="mobile" />
    </div>

    <div
      class="h-full sm:h-auto flex flex-col gap-4 sm:justify-between sm:flex-row lg:flex-col"
    >
      <ContentList data={contentList} />
      <FactSlider data={factSlider} />
      <div class="hidden md:block">
        <Contact data={contactData} platform="desktop" />
      </div>
    </div>
  </div>
</PortfolioLayout>
