---
import Heading from '@components/atoms/Heading.astro';

import ProjectSlider from '@components/organisms/ProjectSlider.astro';
import PortfolioLayout from '@layouts/PortfolioLayout.astro';
import {
  getProjectsData,
  getProjectsDescription,
  getProjectsSchema,
  getProjectsTitle,
} from '@data/index';
import type { Lang } from '@data/consts';

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { lang: 'es' as Lang } },
    { params: { lang: 'en' }, props: { lang: 'en' as Lang } },
  ];
}

const { lang } = Astro.props;

const projects = getProjectsData(lang);
const pageTitle = getProjectsTitle(lang);
const pageDescription = getProjectsDescription(lang);
const schema = getProjectsSchema(lang);
---

<PortfolioLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  schema={schema}
>
  <Heading
    slot="header-bubble"
    text={lang === 'es' ? 'Proyectos' : 'Projects'}
    type="bubble"
  />
  <ProjectSlider data={projects} />
</PortfolioLayout>
