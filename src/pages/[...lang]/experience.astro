---
import Heading from '@components/atoms/Heading.astro';
import CertificateScroller from '@components/organisms/CertificateScroller.astro';
import ImageCard from '@components/organisms/ImageCard.astro';
import Timeline from '@components/organisms/Timeline.astro';
import PortfolioLayout from '@layouts/PortfolioLayout.astro';
import {
  getTimelineData,
  getCertificateScrollerData,
  getImageCardData,
  getExperienceTitle,
  getExperienceDescription,
  getExperienceSchema,
} from '@data/index';
import type { Lang } from '@data/consts';

export function getStaticPaths() {
  return [
    { params: { lang: undefined }, props: { lang: 'es' as Lang } },
    { params: { lang: 'en' }, props: { lang: 'en' as Lang } },
  ];
}

const { lang } = Astro.props;

const timelineData = getTimelineData(lang);
const certificateScroller = getCertificateScrollerData(lang);
const imageCardData = getImageCardData(lang);
const pageTitle = getExperienceTitle(lang);
const pageDescription = getExperienceDescription(lang);
const schema = getExperienceSchema(lang);
---

<PortfolioLayout
  isScrollable={true}
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  schema={schema}
>
  <Heading
    slot="header-bubble"
    text={lang === 'es' ? 'Experiencia' : 'Experience'}
    type="bubble"
  />
  <div
    class="w-full flex-1 min-h-0 flex flex-col gap-4 xl:flex-row xl:justify-between"
  >
    <Timeline data={timelineData} />
    <div class="w-full h-full flex flex-col gap-4 sm:flex-row lg:flex-col">
      <CertificateScroller data={certificateScroller} />
      <ImageCard data={imageCardData} />
    </div>
  </div>
</PortfolioLayout>
