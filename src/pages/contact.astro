---
import Title from '@components/Title.astro';
import MainLayout from '@layouts/MainLayout.astro';
import AppLink from '@components/AppLink.astro';
import ContactForm from '@components/ContactForm.astro';
import Button, { type ButtonData } from '@components/Button.astro';
import GlassWrapper from '@components/GlassWrapper.astro';

const linkedinData = {
  url: 'https://www.linkedin.com/in/jairo-cereceda-berciano/',
  text: 'Linkedin',
  icon: 'linkedin',
};

const githubData = {
  url: 'https://github.com/jairo-cereceda',
  text: 'GitHub',
  icon: 'github',
};

const homeButton: ButtonData = {
  text: 'Inicio',
  url: '/',
  style: 'secondary',
};

const mailtoData = {
  url: 'mailto:',
  text: 'Enviar Mail',
  icon: 'mail',
};
---

<MainLayout title="Jairo Cereceda Berciano - Contacto">
  <section class="p-3 max-w-[800px] w-full my-0 mx-auto">
    <Title first="Contac" highlighted="t" final="o" />

    <AppLink data={linkedinData} />
    <AppLink data={githubData} />
    <AppLink data={mailtoData} />

    <GlassWrapper padding={true}>
      <div class="flex gap-4 items-center">
        <span
          class="block w-3 h-3 rounded-full bg-green-500 shadow-[0_0_8px_2px_rgba(34,197,94,0.8)]"
        ></span>
        Actualmente disponible para nuevos proyectos
      </div>
    </GlassWrapper>

    <div class="flex justify-center">
      <Button data={homeButton} />
    </div>
  </section>
</MainLayout>
