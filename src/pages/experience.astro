---
import Heading from '@components/atoms/Heading.astro';
import CertificateScroller from '@components/organisms/CertificateScroller.astro';
import Timeline from '@components/organisms/Timeline.astro';
import PortfolioLayout from '@layouts/PortfolioLayout.astro';

const timelineData = {
  items: [
    {
      title: 'Febrero 2026 - Actualidad',
      position: 'Proyectos personales y aprendizaje',
    },
    {
      title: 'Marzo 2025 - Febrero 2026',
      position: 'UI developer en Knowmad mood',
    },
    {
      title: 'Septiembre 2023 - Junio 2025',
      position: 'Estudiante de DAW en IES Mar de Cádiz',
    },
  ],
};

const certificateScroller = {
  title: 'Certificaciones',
  imgs: [
    {
      img: 'img/pfp.png',
      imgAlt: 'prueba',
    },
    {
      img: 'img/mock.png',
      imgAlt: 'prueba',
    },
    {
      img: 'img/pfp.png',
      imgAlt: 'prueba',
    },
  ],
};
---

<PortfolioLayout>
  <Heading text="Experiencia" type="bubble" />
  <div
    class="w-full flex-1 min-h-0 flex flex-col gap-4 xl:flex-row xl:justify-between"
  >
    <Timeline data={timelineData} />
    <CertificateScroller data={certificateScroller} />
  </div>
</PortfolioLayout>
